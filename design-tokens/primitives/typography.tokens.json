{
  "typography": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": "Barlow Condensed",
        "$description": "Used for headings, labels, badges, and dense numeric UI"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Barlow",
        "$description": "Used for body text, descriptions, and navigation"
      }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 },
      "extrabold": { "$type": "number", "$value": 800 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "10px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "md-lg": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "28px" },
      "4xl": { "$type": "dimension", "$value": "32px" }
    },
    "lineHeight": {
      "none": { "$type": "number", "$value": 1 },
      "tight": { "$type": "number", "$value": 1.1 },
      "snug": { "$type": "number", "$value": 1.25 },
      "relaxed": { "$type": "number", "$value": 1.3 },
      "loose": { "$type": "number", "$value": 1.4 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  }
}
