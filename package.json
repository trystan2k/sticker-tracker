{
  "name": "sticker-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A mobile-first, client-only Sticker tracker used to track the stickers that users have already and the ones missing in your album.",
  "keywords": [
    "mobile",
    "sticker",
    "sports",
    "tracker",
    "web",
    "world cup",
    "fifa world cup",
    "album",
    "2026"
  ],
  "type": "module",
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "vite",
    "prebuild": "pnpm tokens:build",
    "build": "vite build",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.json",
    "prepare": "husky",
    "lint": "pnpm lint:oxlint && pnpm lint:stylelint",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "pnpm lint:fix:oxlint && pnpm lint:fix:stylelint",
    "lint:fix:oxlint": "oxlint --fix --deny-warnings",
    "lint:fix:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest run --coverage --watch",
    "pretest": "pnpm tokens:build",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "complete-check": "pnpm knip:fix && pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test && pnpm test:e2e && pnpm build",
    "knip": "knip",
    "knip:fix": "pnpm knip --fix"
  },
  "dependencies": {
    "@base-ui/react": "~1.4.1",
    "@tanstack/react-router": "~1.169.1",
    "@tanstack/react-start": "~1.167.63",
    "@tanstack/react-devtools": "~0.10.2",
    "@tanstack/react-router-devtools": "~1.166.13",
    "i18next": "~26.0.8",
    "modern-screenshot": "~4.7.0",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-i18next": "~17.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "~20.5.3",
    "@commitlint/config-conventional": "~20.5.3",
    "@playwright/test": "~1.59.1",
    "@tanstack/devtools-vite": "~0.6.0",
    "@types/node": "~25.6.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.1",
    "@vitest/browser-playwright": "~4.1.5",
    "@vitest/coverage-v8": "~4.1.5",
    "husky": "~9.1.7",
    "knip": "~6.12.0",
    "lint-staged": "~17.0.2",
    "oxfmt": "~0.48.0",
    "oxlint": "~1.63.0",
    "oxlint-tsgolint": "~0.22.1",
    "playwright": "~1.59.1",
    "style-dictionary": "~5.4.0",
    "stylelint": "~17.11.0",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "~6.0.3",
    "vite": "~8.0.10",
    "vite-plugin-killer-instincts": "~1.1.0",
    "vitest": "~4.1.5",
    "vitest-browser-react": "~2.2.0"
  },
  "engines": {
    "node": "^26.1.0",
    "pnpm": "^11.0.8"
  },
  "packageManager": "pnpm@11.0.8"
}
