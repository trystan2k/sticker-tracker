{
  "name": "sticker-tracker",
  "version": "1.25.0",
  "private": true,
  "description": "A mobile-first, client-only Sticker tracker used to track the stickers that users have already and the ones missing in your album.",
  "keywords": [
    "2026",
    "album",
    "fifa world cup",
    "mobile",
    "sports",
    "sticker",
    "tracker",
    "web",
    "world cup"
  ],
  "type": "module",
  "scripts": {
    "predev": "pnpm tokens:build && node scripts/sync-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "pnpm tokens:build && node scripts/sync-ocr-assets.mjs",
    "build": "vite build",
    "postbuild": "node scripts/generate-sw.mjs",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.js",
    "prepare": "husky",
    "lint": "pnpm lint:oxlint && pnpm lint:stylelint",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "pnpm lint:fix:oxlint && pnpm lint:fix:stylelint",
    "lint:fix:oxlint": "oxlint --fix --deny-warnings",
    "lint:fix:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest run --coverage --watch",
    "pretest": "pnpm tokens:build",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview:e2e": "pnpm build && pnpm exec vite preview --host 127.0.0.1 --strictPort --port 4173",
    "complete-check": "pnpm knip:fix && pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test && pnpm test:e2e && pnpm build",
    "knip": "knip",
    "knip:fix": "pnpm knip --fix"
  },
  "dependencies": {
    "@fontsource/barlow": "~5.2.8",
    "@fontsource/barlow-condensed": "~5.2.8",
    "@fontsource/inter": "~5.2.8",
    "@tanstack/react-router": "~1.170.17",
    "@tanstack/react-start": "~1.168.27",
    "@tesseract.js-data/eng": "~1.0.0",
    "flag-icons": "~7.5.0",
    "i18next": "~26.3.5",
    "idb": "~8.0.3",
    "lucide-react": "~1.23.0",
    "mixpanel-browser": "~2.80.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-i18next": "~17.0.8",
    "tesseract.js": "~7.0.0",
    "tesseract.js-core": "~7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.12.1",
    "@commitlint/cli": "~21.1.0",
    "@commitlint/config-conventional": "~21.1.0",
    "@playwright/test": "~1.61.1",
    "@tanstack/devtools-vite": "~0.8.1",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "~26.0.1",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.3",
    "@vitest/browser-playwright": "~4.1.9",
    "@vitest/coverage-v8": "~4.1.9",
    "husky": "~9.1.7",
    "knip": "~6.20.0",
    "lint-staged": "~17.0.8",
    "oxfmt": "~0.56.0",
    "oxlint": "~1.71.0",
    "oxlint-tsgolint": "~0.23.0",
    "playwright": "~1.61.1",
    "style-dictionary": "~5.5.0",
    "stylelint": "~17.13.0",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "~6.0.3",
    "vite": "~8.1.0",
    "vite-plugin-killer-instincts": "~1.1.0",
    "vitest": "~4.1.9",
    "workbox-build": "~7.4.1",
    "wrangler": "~4.104.0"
  },
  "engines": {
    "node": "^24.14.1",
    "pnpm": "^11.0.8"
  },
  "packageManager": "pnpm@11.0.8"
}
