{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "source": "docs/design/sticker-tracker.pen",
    "project": "Figurinhas da Copa 2026",
    "themes": ["light", "dark"]
  },
  "color": {
    "accent": {
      "primary": {
        "$type": "color",
        "$value": {
          "light": "#00A651",
          "dark": "#00CC66"
        },
        "$description": "Brand green – pitch / FIFA grass"
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "light": "#F5A623",
          "dark": "#FFBE4D"
        },
        "$description": "Trophy gold"
      },
      "coca-cola": {
        "$type": "color",
        "$value": "#CC0000",
        "$description": "Coca-Cola red – scoped to CC sponsor page only"
      }
    },
    "surface": {
      "primary": {
        "$type": "color",
        "$value": {
          "light": "#F5F7F5",
          "dark": "#141A14"
        },
        "$description": "Page / canvas background"
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "light": "#FFFFFF",
          "dark": "#1E271E"
        },
        "$description": "Card / sheet background"
      },
      "tertiary": {
        "$type": "color",
        "$value": {
          "light": "#E8EDE8",
          "dark": "#263026"
        },
        "$description": "Subtle fill / icon backgrounds"
      }
    },
    "header-bg": {
      "$type": "color",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#1A221A"
      },
      "$description": "App header / nav bar background"
    },
    "border": {
      "$type": "color",
      "$value": {
        "light": "#D4E4D4",
        "dark": "#2A3A2A"
      },
      "$description": "Dividers and subtle strokes"
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": {
          "light": "#0D1F0D",
          "dark": "#E8F0E8"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "light": "#4A6A4A",
          "dark": "#8AAA8A"
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text on green/gold accent backgrounds"
      }
    },
    "sticker": {
      "collected-bg": {
        "$type": "color",
        "$value": {
          "light": "#00A651",
          "dark": "#00CC66"
        }
      },
      "collected-text": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "missing-bg": {
        "$type": "color",
        "$value": {
          "light": "#FFFFFF",
          "dark": "#1E271E"
        }
      },
      "missing-border": {
        "$type": "color",
        "$value": {
          "light": "#B8CEB8",
          "dark": "#3A4F3A"
        }
      },
      "missing-text": {
        "$type": "color",
        "$value": {
          "light": "#8AA88A",
          "dark": "#4A6A4A"
        }
      }
    },
    "filter": {
      "active-bg": {
        "$type": "color",
        "$value": {
          "light": "#00A651",
          "dark": "#00CC66"
        }
      },
      "inactive-bg": {
        "$type": "color",
        "$value": {
          "light": "#E8EDE8",
          "dark": "#263026"
        }
      }
    },
    "progress-track": {
      "$type": "color",
      "$value": {
        "light": "#D4E4D4",
        "dark": "#2A3A2A"
      }
    }
  },
  "typography": {
    "font-heading": {
      "$type": "fontFamily",
      "$value": "Barlow Condensed",
      "$description": "Used for headings, labels, badges, numbers"
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": "Barlow",
      "$description": "Used for body text, descriptions, navigation"
    },
    "size": {
      "xs":  { "$type": "dimension", "$value": "10rpx" },
      "sm":  { "$type": "dimension", "$value": "12rpx" },
      "md":  { "$type": "dimension", "$value": "14rpx" },
      "lg":  { "$type": "dimension", "$value": "18rpx" },
      "xl":  { "$type": "dimension", "$value": "24rpx" },
      "2xl": { "$type": "dimension", "$value": "32rpx" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4rpx" },
    "sm": { "$type": "dimension", "$value": "8rpx" },
    "md": { "$type": "dimension", "$value": "16rpx" },
    "lg": { "$type": "dimension", "$value": "24rpx" },
    "xl": { "$type": "dimension", "$value": "32rpx" }
  },
  "borderRadius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "layout": {
    "header-height":    { "$type": "dimension", "$value": "56px" },
    "filter-row-height":{ "$type": "dimension", "$value": "44px" },
    "bottom-safe-area": { "$type": "dimension", "$value": "34px" },
    "base-padding":     { "$type": "dimension", "$value": "16px" },
    "sticker-min-tap":  { "$type": "dimension", "$value": "44px" },
    "sticker-columns-mobile": { "$type": "number", "$value": 5 }
  }
}
